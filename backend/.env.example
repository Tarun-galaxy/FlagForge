# Rename this file to ".env" and fill in your real values

# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flags_db

# Format: redis://<host>:<port>/<db_number>
REDIS_URL=redis://localhost:6379/0

# Frontend origin allowed to call this API (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
